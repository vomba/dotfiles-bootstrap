      "provider_update": {
        "provider": "snap",
        "name": "chromium",
        "channel": "latest/stable"
      },
      "update": {
        "provider": "chromiumdash",
        "url": "https://chromiumdash.appspot.com/fetch_releases?channel=Stable&platform=Linux&num=1"
