      ],
      "when": "desktop.enable",
      "version": "1.71.32",
      "policy": "latest-stable",
      "privileged_actions": [
        "provision",
        "retire"
      ],
      "build_before_provision": true,
      "requires": [
        "gui-dpkg",
        "gui-abi-check",
        "gtk3",
        "gui-nss",
        "gui-xss",
        "gui-xtst",
        "gui-notify",
        "gui-atspi",
        "gui-uuid",
        "gui-secret",
