  "services": [
    {
      "id": "snapd-socket",
      "platforms": [
        "linux-x64"
      ],
      "when": "desktop.enable",
      "manager": "systemd-system",
      "name": "snapd.socket",
      "existing_unit": true,
      "unit_package": "snapd",
      "package_id": "gui-snapd",
      "ownership": "Enable/start only through explicit privileged bootstrap services; never restart/disable shared snapd on application retirement; APT owns unit bytes and system daemon state."
    }
  ],
  "artifacts": {
    "gui-kitty-linux": {
      "source_manifest": "native/gui/linux-sources.json",
