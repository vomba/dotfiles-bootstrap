{
  "schema_version": 1,
  "packages": [
    {
      "id": "gui-dpkg",
      "provider": "apt",
      "name": "dpkg",
      "platforms": [
        "linux-x64"
      ],
      "when": "desktop.enable",
      "policy": "distro-security",
      "reason": "Noble native .deb inspection/repack/install ownership, not a foreign-release package manager.",
      "executables": {
        "dpkg-deb": "/usr/bin/dpkg-deb",
        "dpkg-query": "/usr/bin/dpkg-query"
      },
      "retain_shared_runtime": true
    },
    {
      "id": "gui-abi-check",
      "provider": "apt",
      "name": "libc-bin",
      "platforms": [
        "linux-x64"
      ],
      "when": "desktop.enable",
      "policy": "distro-security",
      "reason": "Native Noble ELF loader/linkage inspection; no bundled system glibc replacement.",
      "executables": {
        "ldd": "/usr/bin/ldd"
      },
      "retain_shared_runtime": true
    },
    {
      "id": "gui-fontconfig",
      "provider": "apt",
      "name": "libfontconfig1",
      "platforms": [
        "linux-x64"
      ],
      "when": "desktop.enable",
      "policy": "distro-security",
      "reason": "Native font matching ABI and installed JetBrains Mono Nerd Font remain separate owners.",
      "retain_shared_runtime": true
    },
    {
      "id": "gui-gl",
