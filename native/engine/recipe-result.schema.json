{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native recipe command result",
  "type": "object",
  "required": [
    "id",
    "status",
    "artifacts",
    "executables"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "built",
        "provisioned",
        "verified",
        "retired",
        "recovered"
      ]
    },
    "artifacts": {
      "type": "array",
      "description": "Actual regular-file byte digests, never directory/receipt surrogate hashes",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "executables": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "details": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "provisioned",
              "verified"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
