[url "ssh://git@github.com/"]
    insteadOf = https://github.com/
[diff "sopsdiffer"]
    textconv = sops -d
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
{{ if .dotfiles.theme.nord.enable -}}
    navigate = true
    minus-style = "syntax #3b4252"
    minus-emph-style = "syntax #4c566a"
    plus-style = "syntax #2e3440"
    plus-emph-style = "syntax #434c5e"
    line-numbers = true
{{ if .dotfiles.shell.enable -}}
    syntax-theme = nord-contrast
{{ end -}}
{{ end -}}
[include]
    path = {{ printf "%s/git/private.conf" .paths.config | quote }}
