<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.dotfiles.gpg-agent</string>
<key>ProgramArguments</key><array>
<string>{{ index .executables "gpg-agent" | html }}</string>
<string>--daemon</string><string>--no-detach</string><string>--enable-ssh-support</string>
</array>
<key>EnvironmentVariables</key><dict><key>GNUPGHOME</key><string>{{ .home | html }}/.gnupg</string></dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
</dict></plist>
