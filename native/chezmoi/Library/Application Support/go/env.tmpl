{{ if not (hasKey .dotfiles.dev.go.env "GOPATH") -}}
GOPATH={{ .home }}/.go
{{ end -}}
{{ range $name, $value := .dotfiles.dev.go.env -}}
{{ if or (not (regexMatch "^[A-Z][A-Z0-9_]*$" $name)) (regexMatch "[\r\n]" $value) }}{{ fail "invalid Go environment key/value" }}{{ end -}}
{{ $name }}={{ $value }}
{{ end -}}
