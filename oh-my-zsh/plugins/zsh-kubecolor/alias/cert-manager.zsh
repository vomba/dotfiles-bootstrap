alias kgci='kubecolor get Issuer'
alias kgcia='kubecolor get Issuer -A'
alias kdci='kubecolor describe Issuer'
alias kdelci='kubecolor delete Issuer'

alias kgcii='kubecolor get ClusterIssuer'
alias kdcii='kubecolor describe ClusterIssuer'
alias kdelcii='kubecolor delete ClusterIssuer'

alias kgc='kubecolor get certificate'
alias kgca='kubecolor get certificate -A'
alias kdc='kubecolor describe certificate'
alias kdelc='kubecolor delete certificate'

alias kgcreq='kubecolor get certificaterequest'
alias kgcreqa='kubecolor get certificaterequest -A'
alias kdcreq='kubecolor describe certificaterequest'
alias kdelcreq='kubecolor delete certificaterequest'

alias kgb='kubecolor get bundle'
alias kdb='kubecolor describe bundle'
alias kdelb='kubecolor delete bundle'
